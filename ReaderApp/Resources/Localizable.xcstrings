          }
        }
      }
    },
    "清空离线缓存": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Clear offline cache"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "清空离线缓存"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "清除離線快取"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "オフラインキャッシュを消去"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "오프라인 캐시 지우기"
          }
        }
      }
    },
    "缓存未能完全清理，请重试。": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The cache could not be fully cleared. Try again."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "缓存未能完全清理，请重试。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "快取未能完全清除，請再試一次。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "キャッシュを完全に消去できませんでした。もう一度お試しください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "캐시를 완전히 지우지 못했습니다. 다시 시도하세요."
          }
        }
      }
    },
    "网络不可用，且此内容尚未缓存。请联网打开一次后再离线阅读。": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The network is unavailable and this content is not cached. Open it online before reading offline."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "网络不可用，且此内容尚未缓存。请联网打开一次后再离线阅读。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "目前無法連線，且此內容尚未快取。請先連線開啟一次，再離線閱讀。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ネットワークに接続できず、このコンテンツはキャッシュされていません。一度オンラインで開いてから、オフラインでお読みください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "네트워크에 연결할 수 없으며 이 콘텐츠는 캐시되지 않았습니다. 온라인에서 한 번 연 후 오프라인으로 읽으세요."
          }
        }
      }
    },
    "自动缓存读过的 GitHub 文章、已列举目录和加载过的图片。断网或限流时使用已有缓存，不下载整个仓库。清空后保留当前页面、来源和授权，未缓存内容仍需联网。": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Automatically saves GitHub articles you read, directory listings you open, and images you load. Uses saved copies when offline or rate limited; does not download entire repositories. Clearing keeps the current page, sources, and credential. Uncached content needs a connection."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "自动缓存读过的 GitHub 文章、已列举目录和加载过的图片。断网或限流时使用已有缓存，不下载整个仓库。清空后保留当前页面、来源和授权，未缓存内容仍需联网。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "自動快取讀過的 GitHub 文章、已瀏覽的目錄與載入過的圖片。離線或請求受限時使用現有快取，不會下載整個儲存庫。清除後會保留目前頁面、來源與授權，尚未快取的內容仍需連線。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "閲覧した GitHub 記事、開いたフォルダ一覧、読み込んだ画像を自動でキャッシュします。オフライン時やレート制限時は既存のキャッシュを使用し、リポジトリ全体はダウンロードしません。消去後も現在のページ、ソース、アクセス許可は保持されます。未キャッシュのコンテンツには接続が必要です。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "읽은 GitHub 글, 열어 본 폴더 목록, 불러온 이미지를 자동으로 캐시합니다. 오프라인이거나 요청이 제한되면 기존 캐시를 사용하며 저장소 전체를 다운로드하지 않습니다. 캐시를 지워도 현재 페이지, 소스, 접근 권한은 유지됩니다. 캐시되지 않은 콘텐츠는 네트워크 연결이 필요합니다."
          }
        }
      }
    },
    "私有缓存按令牌隔离并加密；清除授权会删除对应缓存。本地原文件不复制到缓存。缓存仅保留在本机，不是跨设备同步。": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Private cached content is encrypted and isolated by token; clearing authorization deletes it. Local original files are not copied. The cache stays on this device and does not sync across devices."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "私有缓存按令牌隔离并加密；清除授权会删除对应缓存。本地原文件不复制到缓存。缓存仅保留在本机，不是跨设备同步。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "私有內容的快取依權杖隔離並加密；清除授權時會刪除對應快取。本機原始檔案不會複製到快取。快取僅保留在此裝置，不會跨裝置同步。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "非公開コンテンツのキャッシュはトークンごとに分離して暗号化され、アクセス許可を削除すると対応するキャッシュも削除されます。ローカルの元ファイルはキャッシュにコピーしません。キャッシュはこのデバイスにのみ保存され、デバイス間では同期されません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "비공개 콘텐츠 캐시는 토큰별로 분리하여 암호화하며 접근 권한을 삭제하면 해당 캐시도 삭제됩니다. 로컬 원본 파일은 캐시에 복사하지 않습니다. 캐시는 이 기기에만 저장되며 기기 간에 동기화되지 않습니다."
          }
        }
      }
    },
