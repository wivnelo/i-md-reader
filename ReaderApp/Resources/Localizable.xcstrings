    "从左侧选择文章，或添加文件夹与公开 GitHub 链接。": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Choose a document in the sidebar, or add a folder or public GitHub link."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "从左侧选择文章，或添加文件夹与公开 GitHub 链接。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "從側邊欄選取文章，或加入資料夾與公開 GitHub 連結。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "サイドバーで記事を選択するか、フォルダや公開 GitHub リンクを追加してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "사이드바에서 글을 선택하거나 폴더 또는 공개 GitHub 링크를 추가하세요."
          }
        }
      }
