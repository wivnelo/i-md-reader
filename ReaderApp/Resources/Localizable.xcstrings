            "state": "translated",
            "value": "This folder reached the GitHub Contents API limit of 1,000 items. A complete listing cannot be guaranteed."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "目录达到 GitHub Contents API 的 1,000 项上限，暂不能保证完整展示。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
